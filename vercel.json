{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "src/**",
          "web/**",
          "graphs/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://129-153-47-234.sslip.io/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
