{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "src/**",
          "web/**",
          "graphs/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/warm",
      "dest": "https://129-153-47-234.sslip.io/api/warm"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://runline-capstone.vercel.app/api/$1",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      }
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
