# UVA CS SLURM cluster (portal.cs.virginia.edu). Sourced by slurm/cluster.sh.
# Every value can be overridden from the environment, e.g. BASE=... bash
# slurm/run_batch.sh test. This is where everything ran up to the DC pilot.

CLUSTER_LABEL="UVA CS cluster"
LOGIN_HOST=portal.cs.virginia.edu

# cpu and gpu each allow 400 cores per user, and nothing here needs a GPU, so
# array tasks ask for both and start wherever a core is free: up to 800 at once.
PARTITION=${PARTITION:-cpu,gpu}
# No allocation flag on the CS cluster.
ACCOUNT=${ACCOUNT:-}
ACCOUNT_REQUIRED=0

# Work root. /bigtemp is volatile and home is 100 GB, so copy results off.
SCRATCH_ROOT=/bigtemp/$USER
BASE=${BASE:-$SCRATCH_ROOT}
# The 11 GB Geofabrik US extract.
US_PBF=${US_PBF:-$BASE/us-latest.osm.pbf}

# Concurrency. CONCURRENT is the %throttle on each precompute array,
# MAX_TILE_SHARDS caps the tile-build array, MAX_ARRAY is the size of one
# array (MaxArraySize is often 1001; check scontrol show config).
CONCURRENT=${CONCURRENT:-800}
MAX_TILE_SHARDS=${MAX_TILE_SHARDS:-800}
MAX_ARRAY=${MAX_ARRAY:-1000}
MAX_TASKS=${MAX_TASKS:-4000}

# Wall time per precompute task; empty keeps precompute_tiles.sbatch's 2 days
# (cpu allows 4).
PRECOMPUTE_TIME=${PRECOMPUTE_TIME:-}

# Python: uv's standalone 3.12 in .venv (see slurm/setup.sh), never a module.
# Nothing to purge on the CS cluster.
MODULE_PURGE=0
# osmium-tool, installed with micromamba (see slurm/extract.sbatch).
OSMIUM_PREFIX=${OSMIUM_PREFIX:-$HOME/.local/osmium}
