# UVA Research Computing's Rivanna/Afton (login.hpc.virginia.edu). Sourced by
# slurm/cluster.sh. Nothing has been run here yet: slurm/README.md has the
# runbook, the sources for each value, and what to check on first login.
# Every value can be overridden from the environment.

CLUSTER_LABEL="UVA RC Rivanna/Afton"
LOGIN_HOST=login.hpc.virginia.edu

# standard: single-node jobs, 7 days max, 1000 cores per user across running
# jobs, 1 SU per core-hour, 9 GB per core by default. There is no default
# partition. gpu refuses jobs that do not ask for a GPU, so unlike the CS
# cluster there is no second partition to borrow.
PARTITION=${PARTITION:-standard}
# Every job must name an allocation (-A). Run `allocations` on a login node
# for the name, all lowercase, then e.g. export ACCOUNT=<allocation>.
ACCOUNT=${ACCOUNT:-}
ACCOUNT_REQUIRED=1

# /scratch/$USER: 10 TB, not backed up, files not accessed for 90 days are
# deleted. Home is 200 GB and slower for jobs. Copy results off after every
# batch (slurm/run_batch.sh --files <batch>).
SCRATCH_ROOT=/scratch/$USER
BASE=${BASE:-$SCRATCH_ROOT}
US_PBF=${US_PBF:-$BASE/us-latest.osm.pbf}

# 1000 cores per user on standard, so at most 1000 tasks run at once however
# many arrays are queued. Lower CONCURRENT to leave room for others.
# MaxArraySize is unverified: check `scontrol show config | grep -i MaxArraySize`
# and lower MAX_ARRAY if it is under 1001.
CONCURRENT=${CONCURRENT:-1000}
MAX_TILE_SHARDS=${MAX_TILE_SHARDS:-1000}
MAX_ARRAY=${MAX_ARRAY:-1000}
MAX_TASKS=${MAX_TASKS:-4000}

# SUs for a job's whole requested time are held when it is submitted and the
# unused part is released when it ends, so 2 days per task would hold 192,000
# SUs for one 4,000-task batch. DC's longest task took 358 min; 12 hours holds
# 48,000 and still leaves twice that. Shorter jobs also start sooner around
# the quarterly maintenance days.
PRECOMPUTE_TIME=${PRECOMPUTE_TIME:-12:00:00}

# Python: uv's standalone 3.12 in .venv, not the miniforge module, so the
# pins in requirements.txt (and pickled graphs) match the laptop and the CS
# cluster. Jobs purge modules so nothing loaded at submit time leaks in.
MODULE_PURGE=1
OSMIUM_PREFIX=${OSMIUM_PREFIX:-$HOME/.local/osmium}
